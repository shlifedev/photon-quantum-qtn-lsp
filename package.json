{
  "private": true,
  "name": "qtn-syntax-highlighting-workspace",
  "description": "Workspace root for QTN Syntax Highlighting project",
  "scripts": {
    "compile": "npm run compile:client && npm run compile:server",
    "compile:client": "cd packages/vscode-extension && tsc -p .",
    "compile:server": "cd packages/language-server && tsc -p .",
    "webpack": "npm run webpack:client && npm run webpack:server",
    "webpack:client": "webpack --config packages/vscode-extension/webpack.config.js --mode production",
    "webpack:server": "webpack --config packages/language-server/webpack.config.js --mode production && node scripts/copy-server-bundle.js",
    "watch:client": "cd packages/vscode-extension && tsc -watch -p .",
    "watch:server": "cd packages/language-server && tsc -watch -p .",
    "bundle:server": "npm run compile:server && npm run webpack:server",
    "prepare:runtimes": "node scripts/prepare-node-runtime.mjs",
    "test:runtimes": "node --test scripts/tests/*.test.mjs",
    "test:package": "node scripts/test-packaged-server.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "tar": "7.5.22",
    "ts-loader": "^9.5.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
