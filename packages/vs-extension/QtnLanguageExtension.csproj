<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <!-- VSSDK 도구(CreatePkgDef.exe 등)는 Windows 전용 — non-Windows에서는 VSIX 생성 건너뜀 -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <CreateVsixContainer>false</CreateVsixContainer>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <CopyVsixManifestToOutput>false</CopyVsixManifestToOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.12.40392" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.11.435" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.12.48" />
    <PackageReference Include="StreamJsonRpc" Version="2.20.13" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\dist\node-runtimes\win-x64\node.exe;..\..\dist\node-runtimes\win-x64\LICENSE;..\..\dist\node-runtimes\win-x64\runtime.json">
      <Link>runtimes\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="QtnLanguage.pkgdef">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="language-configuration.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Grammars\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- 단일 webpack 번들 — 의존성 포함이라 node_modules 동봉 불필요 (repo 루트에서 npm run bundle:server 선행) -->
    <Content Include="..\language-server\dist\server.js">
      <Link>LanguageServer\server.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Target Name="VerifyBundledRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\language-server\dist\server.js')" Text="Missing QTN server bundle. Run npm run bundle:server at the repository root." />
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\prepare-node-runtime.mjs&quot; --target=vs --check" />
  </Target>
  <!-- VsSDK.targets는 SDK targets 이후에 import해야 $(TargetName), $(OutDir) 등이 올바르게 설정됨 -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
